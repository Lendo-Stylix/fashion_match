# Copy to .env and adjust as needed. .env is gitignored.
# ---- HuggingFace cache: MUST live on D: drive, not C: ----
# HF_HUB_CACHE takes precedence and points the snapshot cache at D:/Models/hf_hub
HF_HOME=D:/Models/hf_home
HF_HUB_CACHE=D:/Models/hf_hub
HUGGINGFACE_HUB_CACHE=D:/Models/hf_hub

# ---- Optional: HF token (for gated models; our 4 adapters are public) ----
# HF_TOKEN=hf_xxx

# ---- Optional: Weights & Biases (LoRA training logs) ----
# WANDB_API_KEY=xxx
# WANDB_PROJECT=outfitmatch

